{
  // Cloudflare 的部署設定。
  //
  // 這個站是純靜態的——沒有伺服器程式、沒有 build step。但 Cloudflare 的新專案
  // 一律走 `npx wrangler deploy`，而那個指令需要這個檔案才知道「要部署的是一個
  // 只有靜態檔的站」。
  //
  // ★ 沒有 "main" 欄位是刻意的：那是 Worker 程式的進入點，這裡沒有伺服器程式。
  // ★ 這個名字就是網址的第一段：<name>.<帳號子網域>.workers.dev
  //   改了它會部署出一個**新的** Worker，舊的不會自動消失。改名之後後端的
  //   ALLOWED_ORIGINS 與 Google OAuth 的授權來源都要跟著改，否則整站
  //   `Failed to fetch`、或登入壞掉。
  "name": "group-judge",
  "compatibility_date": "2026-10-01",

  // 整個 repo 根目錄就是網站內容，index.html 在根目錄。
  // 不該公開的檔案列在 .assetsignore。
  "assets": {
    "directory": "./",

    // 找不到對應檔案時回 404，不要自動導回 index.html。這個站沒有前端路由
    // （頁籤切換只改網址的 # 後面），導回首頁只會把「檔名打錯」偽裝成
    // 「頁面正常」，更難查。
    "not_found_handling": "404-page"
  }
}
